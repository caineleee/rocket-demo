# ========================================
# 全局环境配置模板
# ----------------------------------------
# 使用方式：
#   1. 复制本文件为 .env:  cp .env.example .env
#   2. 运行 ./scripts/update-env.sh 自动检测局域网 IP 并写入 .env
#      （或手动修改 HOST_IP / NACOS_SERVER_ADDR 为本机 IP）
#   3. 启动服务:  ./scripts/dev-start.sh user-service
#      （dev-start.sh 会自动 source .env，把变量注入 Spring Boot 进程）
#
# ⚠️ .env 文件不支持嵌套变量引用！
#    不能写 NACOS_SERVER_ADDR=${HOST_IP}:8848
#    当 HOST_IP 变化时，NACOS_SERVER_ADDR 也要同步更新
#    （update-env.sh 会同时更新这两项，无需手动改）
# ========================================

# 宿主机 IP 地址（Docker 容器访问宿主机的地址）
# 占位值 127.0.0.1 仅作示例，请用 update-env.sh 自动检测，或手动改成 ifconfig 查到的局域网 IP
HOST_IP=127.0.0.1

# RocketMQ NameServer 地址
# ROCKETMQ_NAMESRV_ADDR: Docker 容器间通信用(服务名)
# ROCKETMQ_NAMESRV:      宿主机本地应用用(端口已映射到宿主机)
ROCKETMQ_NAMESRV_ADDR=namesrv-1:9876
ROCKETMQ_NAMESRV=localhost:9876

# MySQL 数据库连接信息
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=rocket-demo-db
MYSQL_USERNAME=root
MYSQL_PASSWORD=root

# Redis 连接信息（应用默认 localhost，容器内用服务名；如非默认可在此覆盖）
REDIS_HOST=localhost
REDIS_PORT=6379

# Sentinel Dashboard 地址（应用默认 localhost:8858）
SENTINEL_DASHBOARD=localhost:8858

# JWT 配置（JwtUtil 直接读取这些环境变量，兼容 Gateway 不扫描 common 包的情况）
# ⚠️ 生产环境务必改为高强度随机密钥（>=32 字节），开发兜底值仅供本地调试
JWT_SECRET=rocket-demo-jwt-secret-key-2026-secure
# Access Token 过期时间（毫秒），默认 30 分钟
JWT_ACCESS_EXPIRE=1800000
# Refresh Token 过期时间（毫秒），默认 7 天
JWT_REFRESH_EXPIRE=604800000

# Nacos 注册中心地址（⚠️ 不能用 ${HOST_IP}，必须直接写 IP）
# 占位值仅作示例，请用 update-env.sh 自动同步为 <本机IP>:8848
NACOS_SERVER_ADDR=127.0.0.1:8848
