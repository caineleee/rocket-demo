<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.lee.rocket.train</groupId>
		<artifactId>rocket-demo</artifactId>
		<version>0.0.1</version>
	</parent>

	<artifactId>common</artifactId>
	<name>common</name>
	<description>Common Module - Shared Configuration and Constants</description>

	<dependencies>
        <!-- Nacos Config：从 Nacos 拉取共享配置（shared-*.yaml），版本由 SCA BOM 管理 -->
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-config</artifactId>
        </dependency>

        <!-- Sentinel 数据源 Nacos：让应用从 Nacos 拉取限流规则（shared-sentinel-dev.yaml 使用）
             版本由 spring-cloud-alibaba-dependencies BOM 管理 -->
        <dependency>
            <groupId>com.alibaba.csp</groupId>
            <artifactId>sentinel-datasource-nacos</artifactId>
        </dependency>

        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
        </dependency>

        <!-- Lombok：@Slf4j/@Data 等代码生成，编译期生效不打入 jar -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- SLF4J：日志门面 API（实现由各服务 logback 提供） -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>

        <!-- Spring Data Redis：Redis 操作（Token 黑名单/Refresh Token 存储） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <!-- Redisson：分布式锁、原子操作等高级 Redis 功能 -->
        <dependency>
            <groupId>org.redisson</groupId>
            <artifactId>redisson-spring-boot-starter</artifactId>
        </dependency>

        <!-- Micrometer：监控埋点（Counter/Timer），与 Spring Boot Actuator 集成 -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-core</artifactId>
        </dependency>

        <!-- Spring AOP：支持 @Aspect 切面 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aop</artifactId>
        </dependency>

        <!-- Spring Web：Servlet MVC（provided，由各业务服务提供实现） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- TTL：TransmittableThreadLocal，支持线程池场景下的上下文自动传递 -->
        <dependency>
            <groupId>com.alibaba</groupId>
            <artifactId>transmittable-thread-local</artifactId>
        </dependency>

        <!-- OpenFeign：用于 Feign 拦截器传递用户上下文 -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-openfeign</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- Dubbo：用于 Dubbo Filter 传递用户上下文 -->
        <dependency>
            <groupId>org.apache.dubbo</groupId>
            <artifactId>dubbo-spring-boot-starter</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- spring-dotenv（Spring Boot 3 自动集成版）：Spring Boot 启动时自动读取项目根目录 .env 文件，
             将变量灌进 Spring Environment（供 application.yml 占位符解析）+ System.getProperties()
             （供 JwtUtil 等纯静态工具类通过 System.getProperty() 读取）。
             不设 optional，让所有依赖 common 的服务（含 gateway）自动继承，无需各服务单独声明。
             版本由父 pom 的 spring-dotenv-bom 管理。 -->
        <dependency>
            <groupId>me.paulschwarz</groupId>
            <artifactId>springboot3-dotenv</artifactId>
            <!-- 必须显式指定 version（Maven transitive 限制，属合理例外）：
                 common 作为 jar 被 user-service 等引用时，Maven 校验 common 的 installed 原始 pom，
                 若 dependency 缺 version 即判 invalid（transitive 不可用），即使父 pom 的 BOM 已管理也不补。
                 实测去 version 后 user-service 报 'dependencies.dependency.version is missing'。
                 版本变量 ${spring-dotenv.version} 仍集中在父 pom properties 统一管理。 -->
            <version>${spring-dotenv.version}</version>
        </dependency>

	</dependencies>
</project>
