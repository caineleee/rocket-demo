<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>3.5.16</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>org.lee.rocket.train</groupId>
	<artifactId>rocket-demo</artifactId>
	<version>0.0.1</version>
	<packaging>pom</packaging>
	<name>rocket-demo</name>
	<description>rocket-demo</description>

	<url/>
	<modules>
		<module>common</module>
		<module>order-service</module>
		<module>pay-service</module>
        <module>coupon-service</module>
        <module>user-service</module>
        <module>goods-service</module>
        <module>service-pojo</module>
        <module>service-api</module>
        <module>mybatis-generator</module>
        <module>gateway-service</module>
	</modules>

	<properties>
		<java.version>21</java.version>
        <mvn.compiler.source>21</mvn.compiler.source>
        <mvn.compiler.target>21</mvn.compiler.target>
        <mybatis.version>3.5.16</mybatis.version>
        <mybatis-plus-generator.version>3.5.16</mybatis-plus-generator.version>
        <freemarker.version>2.3.33</freemarker.version>
        <rocketmq.version>2.3.5</rocketmq.version>
        <dubbo.version>3.3.6</dubbo.version>
        <nacos.version>2.4.0</nacos.version>
        <spring-cloud.version>2025.0.3</spring-cloud.version>
        <spring-cloud-alibaba.version>2023.0.3.2</spring-cloud-alibaba.version> 
        <springdoc.version>2.8.16</springdoc.version>
        <mysql-connector.version>8.0.33</mysql-connector.version>
        <!-- Redisson：基于 Redis 的分布式锁、原子操作等高级功能 -->
        <redisson.version>3.36.0</redisson.version>
        <!-- JJWT：JWT 令牌生成与解析（api 接口 + impl/jackson 实现） -->
        <jjwt.version>0.12.5</jjwt.version>
        <!-- TransmittableThreadLocal：线程池场景下用户上下文自动传递 -->
        <ttl.version>2.14.3</ttl.version>
        <!-- spring-dotenv：Spring Boot 启动时自动读取项目根目录 .env，替代 source .env -->
        <spring-dotenv.version>5.1.0</spring-dotenv.version>
        <!-- exec-maven-plugin：在 initialize phase 自动跑 update-env.sh，检测局域网 IP 并更新 .env -->
        <exec-maven-plugin.version>3.1.0</exec-maven-plugin.version>
	</properties>

	<build>
		<pluginManagement>
			<plugins>
				<!-- spring-boot-maven-plugin 公共配置：
				     JVM 参数必须在 JVM 启动前设置（早于 Spring Environment），不能靠 .env/spring-dotenv。
				     (1) -Dnacos.logging.default.config.enabled=false
				         禁用 Nacos 客户端默认 logback 配置，避免与项目 logback-spring.xml 冲突
				         （"already has an associated action supplier"），Nacos 客户端在 Spring Environment
				          准备前就静态初始化 logback 适配器，application.yml 配置来不及生效。
				     (2) -DJM.SNAPSHOT.PATH
				         指定 Nacos 本地缓存目录到项目内 .nacos-cache，避免 ~/nacos 在 macOS 沙箱下不可写。
				     (3) -Dspringdotenv.directory=${project.basedir}/..
				         指定 .env 文件所在目录为项目根目录。spring-dotenv 默认在 ./（工作目录=子模块目录）
				         找 .env，但 .env 在项目根目录；不设此参数会找不到 .env（ignoreIfMissing=true 默认
				         静默忽略，无报错），JwtUtil 拿不到 .env 变量只能用兜底值。
				     (4) -Dspringdotenv.exportToSystemProperties=true
				         把 .env 变量导出到 System.getProperties()，供 JwtUtil 等纯静态工具类通过
				         System.getProperty() 读取。该参数原写在 Nacos 共享配置，但 Nacos 配置由
				         PropertySourceLocator 在 context refresh 阶段加载，晚于 spring-dotenv 的
				         EnvironmentPostProcessor，导致 spring-dotenv 读不到、默认 false 不导出。
				         改用 JVM -D 参数，在 JVM 启动时就生效，早于所有 Spring 扩展点。
				     子模块只声明 plugin 不写 configuration 即可继承此配置。 -->
				<plugin>
					<groupId>org.springframework.boot</groupId>
					<artifactId>spring-boot-maven-plugin</artifactId>
					<configuration>
						<jvmArguments>
							-Dnacos.logging.default.config.enabled=false
							-DJM.SNAPSHOT.PATH=${project.basedir}/../.nacos-cache
							-Dspringdotenv.directory=${project.basedir}/..
							-Dspringdotenv.exportToSystemProperties=true
						</jvmArguments>
					</configuration>
				</plugin>
			</plugins>
		</pluginManagement>

		<plugins>
			<!-- exec-maven-plugin：mvn 生命周期 initialize 阶段自动执行 update-env.sh
			     检测宿主机局域网 IP 并同步 .env 的 HOST_IP / NACOS_SERVER_ADDR，
			     解决切换网段后 RocketMQ broker 注册地址失效问题。
			     绑定 initialize phase（早于 spring-boot:run），所有子模块继承执行（脚本幂等，无害）。
			     successCodes=0：.env 不存在时 update-env.sh 退出码非 0，不应阻断构建。 -->
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>exec-maven-plugin</artifactId>
				<version>${exec-maven-plugin.version}</version>
				<executions>
					<execution>
						<id>update-env-on-startup</id>
						<phase>initialize</phase>
						<goals>
							<goal>exec</goal>
						</goals>
						<configuration>
							<executable>bash</executable>
							<arguments>
								<argument>${project.basedir}/../scripts/update-env.sh</argument>
							</arguments>
							<successCodes>
								<successCode>0</successCode>
							</successCodes>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
	<dependencyManagement>
		<dependencies>
            <!-- ==================== 内部模块 ==================== -->
            <!-- common：公共模块（常量/异常/工具/过滤器/上下文传递），被所有服务依赖 -->
            <dependency>
                <groupId>org.lee.rocket.train</groupId>
                <artifactId>common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <!-- service-pojo：实体类 + 共享 Mapper 接口（被各服务与 service-api 依赖） -->
            <dependency>
                <groupId>org.lee.rocket.train</groupId>
                <artifactId>service-pojo</artifactId>
                <version>${project.version}</version>
            </dependency>
            <!-- service-api：Dubbo RPC 服务接口 + Feign 客户端（被各服务依赖） -->
            <dependency>
                <groupId>org.lee.rocket.train</groupId>
                <artifactId>service-api</artifactId>
                <version>${project.version}</version>
            </dependency>

            
            <!-- ① Spring Cloud 核心 BOM（必须在 SCA 之前） -->
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- ② Spring Cloud Alibaba BOM（管理 Nacos/Sentinel/Seata 等版本） -->
            <dependency>
                <groupId>com.alibaba.cloud</groupId>
                <artifactId>spring-cloud-alibaba-dependencies</artifactId>
                <version>${spring-cloud-alibaba.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- spring-dotenv BOM：让 Spring Boot 自动读取项目根目录 .env 文件 -->
            <dependency>
                <groupId>me.paulschwarz</groupId>
                <artifactId>spring-dotenv-bom</artifactId>
                <version>${spring-dotenv.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- ==================== 数据库 / 持久层 ==================== -->
            <!-- MyBatis-Plus：MyBatis 增强（CRUD/分页/条件构造器） -->
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
                <version>${mybatis.version}</version>
            </dependency>
            <!-- MyBatis-Plus 核心（实体/注解） -->
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-core</artifactId>
                <version>${mybatis.version}</version>
            </dependency>
            <!-- MyBatis-Plus 代码生成器（mybatis-generator 模块用） -->
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-generator</artifactId>
                <version>${mybatis-plus-generator.version}</version>
            </dependency>
            <!-- Freemarker 模板引擎（代码生成器模板渲染） -->
            <dependency>
                <groupId>org.freemarker</groupId>
                <artifactId>freemarker</artifactId>
                <version>${freemarker.version}</version>
            </dependency>
            <!-- MySQL JDBC 驱动 -->
            <dependency>
                <groupId>com.mysql</groupId>
                <artifactId>mysql-connector-j</artifactId>
                <version>${mysql-connector.version}</version>
                <scope>runtime</scope>
            </dependency>

            <!-- ==================== 消息 / RPC ==================== -->
            <!-- RocketMQ：消息中间件 Spring 集成（事务消息/顺序/广播） -->
            <dependency>
                <groupId>org.apache.rocketmq</groupId>
                <artifactId>rocketmq-spring-boot-starter</artifactId>
                <version>${rocketmq.version}</version>
            </dependency>
            <!-- Dubbo：RPC 框架（服务间同步调用） -->
            <dependency>
                <groupId>org.apache.dubbo</groupId>
                <artifactId>dubbo-spring-boot-starter</artifactId>
                <version>${dubbo.version}</version>
            </dependency>

            <!-- ==================== 注册 / 配置中心 ==================== -->
            <!-- Nacos 客户端：配置中心 + 服务发现 -->
            <dependency>
                <groupId>com.alibaba.nacos</groupId>
                <artifactId>nacos-client</artifactId>
                <version>${nacos.version}</version>
            </dependency>

            <!-- ==================== 缓存 / 分布式 ==================== -->
            <!-- Redisson：分布式锁、原子操作等高级 Redis 功能 -->
            <dependency>
                <groupId>org.redisson</groupId>
                <artifactId>redisson-spring-boot-starter</artifactId>
                <version>${redisson.version}</version>
            </dependency>
            <!-- TTL：TransmittableThreadLocal，线程池场景下上下文自动传递 -->
            <dependency>
                <groupId>com.alibaba</groupId>
                <artifactId>transmittable-thread-local</artifactId>
                <version>${ttl.version}</version>
            </dependency>

            <!-- ==================== 安全 / JWT ==================== -->
            <!-- JJWT：JWT 令牌生成与解析（api 接口声明，impl/jackson 运行时实现） -->
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-api</artifactId>
                <version>${jjwt.version}</version>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-impl</artifactId>
                <version>${jjwt.version}</version>
                <scope>runtime</scope>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-jackson</artifactId>
                <version>${jjwt.version}</version>
                <scope>runtime</scope>
            </dependency>

            <!-- ==================== 文档 ==================== -->
            <!-- SpringDoc：OpenAPI 3 文档 + Swagger UI -->
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>
		</dependencies>
	</dependencyManagement>

</project>
